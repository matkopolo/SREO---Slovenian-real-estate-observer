# Compose reads these from .env (copy this file). Every value has a default in
# docker-compose.yml, so .env is optional.
REFRESH_INTERVAL_DAYS=14
REFRESH_RETRY_HOURS=1
# auto: retrain valuation models when the data changed; manual: only on `make models-refresh`.
MODEL_REFRESH_POLICY=auto
ANALYTICS_PROGRESS_INTERVAL_SECONDS=15
MODEL_DETAILED_PROGRESS=false
LOG_LEVEL=INFO
# Login password of the pipeline worker's least-privilege database role.
# URL-safe characters only (it is embedded in the worker's DATABASE_URL).
PIPELINE_DATABASE_PASSWORD=real_estate_pipeline
