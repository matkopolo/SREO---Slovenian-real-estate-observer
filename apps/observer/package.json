{
  "name": "sreo-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:api-types": "openapi-typescript ../real-estate-api/openapi/openapi.yaml -o src/generated/api-schema.d.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
